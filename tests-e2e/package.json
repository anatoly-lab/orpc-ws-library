{
  "name": "@repo/tests-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-package e2e suite. `test` runs the node-level vitest round-trips that need BOTH cores together (e.g. server↔client bidirectional RPC) — no Docker. `test:e2e` runs the Playwright suite driving the cookie-BFF demo SPA + demo server + real Keycloak (testcontainers), which no single-package test can cover.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:list": "playwright test --list",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .turbo playwright-report test-results *.tsbuildinfo"
  },
  "devDependencies": {
    "@orpc-ws/client": "workspace:*",
    "@orpc-ws/server": "workspace:*",
    "@orpc/client": "1.14.14",
    "@orpc/contract": "1.14.14",
    "@orpc/server": "1.14.14",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "rimraf": "6.1.3",
    "testcontainers": "12.1.0",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "ws": "8.21.2"
  }
}
