{
  "name": "orpc-ws-library",
  "version": "0.1.1",
  "private": true,
  "description": "Monorepo for the @orpc-ws/* library family (framework-agnostic ORPC over WebSocket).",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:e2e": "pnpm --filter @repo/tests-e2e run test:e2e",
    "ci": "turbo run lint typecheck test build",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "build:demo": "turbo run build --filter='@demo/*'",
    "dev:demo": "turbo run dev --filter=@demo/pkce-server --filter=@demo/pkce-client",
    "dev:server": "pnpm dev:server:pkce",
    "dev:server:pkce": "pnpm --filter @demo/pkce-server dev",
    "dev:server:backend-token": "pnpm --filter @demo/backend-token-server dev",
    "dev:server:cookie-bff": "pnpm --filter @demo/cookie-bff-server dev",
    "dev:pkce": "pnpm --filter @demo/pkce-client dev",
    "dev:backend-token": "pnpm --filter @demo/backend-token-client dev",
    "dev:cookie-bff": "pnpm --filter @demo/cookie-bff-client dev",
    "preview:demo:pkce": "pnpm --filter @demo/pkce-client preview",
    "preview:demo:backend-token": "pnpm --filter @demo/backend-token-client preview",
    "preview:demo:cookie-bff": "pnpm --filter @demo/cookie-bff-client preview",
    "upgrade:interactive": "pnpm update --recursive --interactive --latest"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "eslint": "10.5.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.6.0",
    "happy-dom": "20.10.3",
    "rimraf": "6.1.3",
    "tshy": "4.1.3",
    "turbo": "2.9.18",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  }
}
