{
  "name": "orpc-ws-library",
  "version": "0.1.1",
  "private": true,
  "description": "Monorepo for the @orpc-ws/* library family (framework-agnostic ORPC over WebSocket).",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:e2e": "pnpm --filter @repo/tests-e2e run test:e2e",
    "ci": "turbo run lint typecheck test build",
    "ci-cacheless": "turbo run lint typecheck test build --force",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "build:demo": "turbo run build --filter='@demo/*'",
    "dev:backend-token": "turbo run dev --filter=@demo/backend-token-server --filter=@demo/backend-token-client",
    "dev:cookie-bff": "turbo run dev --filter=@demo/cookie-bff-server --filter=@demo/cookie-bff-client",
    "dev:authless": "turbo run dev --filter=@demo/authless-server --filter=@demo/authless-client",
    "upgrade:interactive": "pnpm update --recursive --interactive --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.15.47",
    "@types/node": "26.1.2",
    "happy-dom": "20.11.1",
    "rimraf": "6.1.3",
    "tshy": "4.1.3",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.10",
    "vitest": "4.1.10"
  }
}
