{
  "name": "@orpc-ws/server",
  "version": "0.11.1",
  "description": "Framework-free ORPC-over-WebSocket server core. Node + ws + @orpc/server. Framework adapters live in sibling packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatoly-lab/orpc-ws-library.git",
    "directory": "packages/orpc-ws-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.22.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!src/package.json",
    "README.md"
  ],
  "tshy": {
    "selfLink": false,
    "exports": {
      ".": "./src/index.ts"
    },
    "project": "./tsconfig.build.json",
    "exclude": [
      "src/**/*.test.ts",
      "src/**/__tests__/**"
    ]
  },
  "scripts": {
    "build": "tshy",
    "prepublishOnly": "tshy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test-types.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo .tshy-build .tsbuildinfo *.tsbuildinfo"
  },
  "dependencies": {
    "@orpc-ws/shared": "workspace:*",
    "@orpc/client": "1.14.8",
    "@orpc/contract": "1.14.8",
    "@orpc/server": "1.14.8",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
