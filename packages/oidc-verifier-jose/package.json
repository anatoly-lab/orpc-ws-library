{
  "name": "@repo/oidc-verifier-jose",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side OIDC token verifier (Discovery + JWKS via jose). Produces a VerifyClient compatible with @repo/orpc-ws-server. Node-only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@repo/orpc-ws-server": "0.1.0",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
