{
  "name": "@orpc-ws/client",
  "version": "0.1.0",
  "description": "Framework-free ORPC-over-WebSocket client core. Vanilla TS — reconnect, heartbeat, sleep detection, uploads. React bindings live in @orpc-ws/oidc-react.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatoly-lab/orpc-ws-library.git",
    "directory": "packages/orpc-ws-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!src/package.json",
    "README.md"
  ],
  "tshy": {
    "exports": {
      ".": "./src/index.ts"
    },
    "project": "./tsconfig.build.json",
    "exclude": [
      "src/**/*.test.ts",
      "src/**/__tests__/**"
    ]
  },
  "scripts": {
    "build": "tshy",
    "prepublishOnly": "tshy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo .tshy-build *.tsbuildinfo"
  },
  "dependencies": {
    "@orpc/client": "1.14.4",
    "@orpc/contract": "1.14.4",
    "@orpc-ws/shared": "0.1.0",
    "partysocket": "1.1.19"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "happy-dom": "20.9.0",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7",
    "ws": "8.21.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
