{
  "name": "@repo/orpc-ws-client",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free ORPC-over-WebSocket client core. Vanilla TS — reconnect, heartbeat, sleep detection, uploads. React bindings live in @repo/orpc-ws-oidc-react.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@orpc/client": "1.14.4",
    "@orpc/contract": "1.14.4",
    "@repo/orpc-ws-shared": "0.1.0",
    "partysocket": "1.1.19"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "happy-dom": "20.9.0",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7",
    "ws": "8.21.0"
  }
}
