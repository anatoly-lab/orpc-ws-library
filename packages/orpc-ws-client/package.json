{
  "name": "@orpc-ws/client",
  "version": "0.12.3",
  "description": "Framework-free ORPC-over-WebSocket client core. Vanilla TS — reconnect, heartbeat, sleep detection, uploads. WS React bindings live in @orpc-ws/react.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatoly-lab/orpc-ws-library.git",
    "directory": "packages/orpc-ws-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.22.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!src/package.json",
    "README.md"
  ],
  "tshy": {
    "selfLink": false,
    "exports": {
      ".": "./src/index.ts"
    },
    "project": "./tsconfig.build.json",
    "exclude": [
      "src/**/*.test.ts",
      "src/**/__tests__/**"
    ]
  },
  "scripts": {
    "build": "tshy",
    "prepublishOnly": "tshy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo .tshy-build .tsbuildinfo *.tsbuildinfo"
  },
  "dependencies": {
    "@orpc-ws/shared": "workspace:*",
    "partysocket": "1.3.0"
  },
  "peerDependencies": {
    "@orpc/client": ">=1.14.8 <2",
    "@orpc/contract": ">=1.14.8 <2",
    "@orpc/server": ">=1.14.8 <2"
  },
  "devDependencies": {
    "@orpc/client": "1.14.14",
    "@orpc/contract": "1.14.14",
    "@orpc/server": "1.14.14",
    "@types/ws": "8.18.1",
    "happy-dom": "20.11.1",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "8.21.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
