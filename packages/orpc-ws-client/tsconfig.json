{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Buildinfo at the package root, NOT inside `dist`: the typecheck pass
    // (`tsc -p tsconfig.json --noEmit`, incremental) writes this file, and
    // `files` ships `dist`, so `./dist/.tsbuildinfo` would get packed.
    // Root `.tsbuildinfo` is gitignored and outside `files`.
    "tsBuildInfoFile": "./.tsbuildinfo",
    // Browser-targeted core: lib includes DOM so the websocket / event
    // types are recognized. No `jsx` — the React adapter is the sibling
    // `@orpc-ws/react`; the core carries no JSX anymore.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
