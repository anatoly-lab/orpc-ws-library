{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // Browser-targeted core: lib includes DOM so the websocket / event
    // types are recognized. No `jsx` — the React adapter moved to
    // `@repo/orpc-ws-oidc-react`; the core carries no JSX anymore.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
