{
  // tshy build config. Extends the package's editor/typecheck tsconfig but
  // relaxes two things that conflict with tshy's dual ESM+CJS emit:
  //
  // 1. `verbatimModuleSyntax: false` — tshy compiles the SAME source a second
  //    time as CommonJS (it drops a `{"type":"commonjs"}` src/package.json for
  //    the CJS pass). Under NodeNext that makes every file CJS-detected, and
  //    `verbatimModuleSyntax` then forbids ESM `import`/`export` syntax in a
  //    CJS file (TS1286). Dev-time strictness is unaffected: `typecheck` still
  //    runs the ESM-only `tsconfig.json` with verbatim ON.
  // 2. `tsBuildInfoFile`/`incremental` off — tshy relocates `outDir` to
  //    `.tshy-build`, so a hard-coded `./dist/.tsbuildinfo` would point outside
  //    the build tree.
  //
  // This is the canonical copy; the sibling packages' tsconfig.build.json
  // files point here for the full rationale.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "incremental": false
  }
}
