{
  "name": "@repo/orpc-ws-shared",
  "version": "0.1.0",
  "private": true,
  "description": "Internal shared types/interfaces (Logger, Clock, Rng) for the @repo/orpc-ws-* family. Not published.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
