{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Buildinfo at the package root, NOT inside `dist`: the typecheck pass
    // (`tsc -p tsconfig.json --noEmit`, incremental) writes this file, and
    // `files` ships `dist`, so `./dist/.tsbuildinfo` would get packed.
    // Root `.tsbuildinfo` is gitignored and outside `files`.
    "tsBuildInfoFile": "./.tsbuildinfo",
    // Browser-only package: lib includes DOM so `crypto.subtle`,
    // `window.location`, `sessionStorage`, `localStorage`, `URLSearchParams`
    // and `fetch` are all in scope without extra @types installs.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
