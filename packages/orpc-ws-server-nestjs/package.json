{
  "name": "@repo/orpc-ws-server-nestjs",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS adapter for @repo/orpc-ws-server. The only package allowed to import @nestjs/* and reflect-metadata.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@repo/orpc-ws-server": "0.1.0",
    "@repo/orpc-ws-shared": "0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/testing": "11.1.24",
    "@orpc/client": "1.14.4",
    "@orpc/server": "1.14.4",
    "@types/express": "5.0.0",
    "@types/ws": "8.18.1",
    "express": "5.1.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "4.1.7",
    "ws": "8.21.0"
  }
}
