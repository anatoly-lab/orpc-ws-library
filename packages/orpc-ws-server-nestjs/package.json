{
  "name": "@orpc-ws/server-nestjs",
  "version": "0.6.1",
  "description": "NestJS adapter for @orpc-ws/server. The only package allowed to import @nestjs/* and reflect-metadata.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatoly-lab/orpc-ws-library.git",
    "directory": "packages/orpc-ws-server-nestjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.22.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!src/package.json",
    "README.md"
  ],
  "tshy": {
    "exports": {
      ".": "./src/index.ts"
    },
    "project": "./tsconfig.build.json",
    "exclude": [
      "src/**/*.test.ts",
      "src/**/__tests__/**"
    ]
  },
  "scripts": {
    "build": "tshy",
    "prepublishOnly": "tshy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo .tshy-build .tsbuildinfo *.tsbuildinfo"
  },
  "dependencies": {
    "@orpc-ws/server": "workspace:*",
    "@orpc-ws/shared": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/testing": "11.1.27",
    "@orpc/client": "1.14.6",
    "@orpc/server": "1.14.6",
    "@types/express": "5.0.6",
    "@types/node": "26.0.0",
    "@types/ws": "8.18.1",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "ws": "8.21.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
