{
  // tshy build config — see packages/orpc-ws-shared/tsconfig.build.json for the
  // full rationale. `verbatimModuleSyntax: false` lets tshy's CommonJS pass
  // emit `require`/`exports` from ESM source without TS1286; `incremental`
  // off avoids a buildinfo path that points outside tshy's relocated outDir.
  // The NestJS-specific `experimentalDecorators` + `emitDecoratorMetadata`
  // are inherited from `tsconfig.json` and survive both tshy passes — they
  // are orthogonal to `verbatimModuleSyntax`. `typecheck` still uses the
  // strict ESM-only `tsconfig.json`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "incremental": false
  }
}
