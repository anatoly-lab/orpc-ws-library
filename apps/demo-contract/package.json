{
  "name": "@demo/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ORPC contract for the orpc-ws-library demo (SPA + NestJS server).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@orpc/contract": "1.14.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
