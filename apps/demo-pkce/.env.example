# Demo SPA env. These VITE_* variables are INLINED into the bundle at
# `vite build` time (per Vite's env-handling rules), not read at runtime.
# Change here, then re-run `vite build` (or restart `vite dev`).
#
# Copy this file to `.env` (or `.env.local`) and tweak.

# OIDC issuer URL — passed verbatim to @orpc-ws/oidc-pkce's createOidcAuth.
# For the local-dev Keycloak realm under tests-e2e/setup/keycloak this is:
VITE_OIDC_ISSUER_URL=http://localhost:18080/realms/orpc-ws-demo

# OIDC client ID (the public SPA client registered with the IdP).
VITE_OIDC_CLIENT_ID=orpc-ws-demo-spa

# WebSocket endpoint URL the ORPC client connects to.
# In dev/e2e the demo server listens on 18081; in production point this
# at wherever your @orpc-ws/server-nestjs app is exposed.
VITE_WS_URL=ws://localhost:18081/ws

# HTTP upload endpoint (server origin + the adapter's httpPath). The
# orpc-http upload strategy's RPCLink appends the procedure path, so the
# image upload lands at POST ${VITE_UPLOAD_URL}/uploadImage.
VITE_UPLOAD_URL=http://localhost:18081/upload
