{
  "name": "@demo/pkce",
  "version": "0.1.0",
  "private": true,
  "description": "Vite + React browser-PKCE auth demo for the orpc-ws-library e2e suite. Auths via Keycloak PKCE; talks to the demo server via @orpc-ws/client. Runs as a standalone process (dev: vite on 5173, e2e: vite preview on 4173).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@demo/contract": "workspace:*",
    "@orpc-ws/client": "workspace:*",
    "@orpc-ws/oidc-pkce": "workspace:*",
    "@orpc-ws/oidc-react": "workspace:*",
    "@orpc-ws/react": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
