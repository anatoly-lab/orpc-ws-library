{
  "name": "@demo/backend-token-client",
  "version": "0.1.0",
  "private": true,
  "description": "Vite + React backend-token auth demo for the orpc-ws-library e2e suite. Server holds the refresh token; the browser pulls a short-lived access token and passes it via the WS `?token=`. Imports ONLY @orpc-ws/client + @orpc-ws/react (no oidc packages) to prove the WS-only consumer path. Runs standalone (dev: vite on 5174, e2e: vite preview on 4174).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@demo/backend-token-contract": "workspace:*",
    "@orpc-ws/client": "workspace:*",
    "@orpc-ws/react": "workspace:*",
    "@orpc/client": "1.14.14",
    "@orpc/contract": "1.14.14",
    "@orpc/server": "1.14.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
