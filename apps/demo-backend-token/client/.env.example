# Demo SPA env. These VITE_* variables are INLINED into the bundle at
# `vite build` time (per Vite's env-handling rules), not read at runtime.
# Change here, then re-run `vite build` (or restart `vite dev`).
#
# Copy this file to `.env` (or `.env.local`) and tweak.

# WebSocket endpoint URL the ORPC client connects to. In the backend-token
# mode the demo server listens on 18082; auth rides as `?token=` carrying the
# short-lived access token the browser pulled from POST /auth/token.
VITE_WS_URL=ws://localhost:18082/ws

# Server origin for the auth HTTP endpoints (/auth/login, /auth/token,
# /auth/refresh, /auth/logout). The httpOnly `sid` cookie set by the server's
# /auth/callback authenticates the token/refresh POSTs (credentials:"include").
VITE_SERVER_ORIGIN=http://localhost:18082
