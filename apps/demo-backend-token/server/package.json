{
  "name": "@demo/backend-token-server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend-token-mode demo server for the orpc-ws-library e2e suite. Runs the OIDC code exchange server-side, holds the refresh token, and hands the SPA short-lived access tokens forwarded over the WS ?token=. The SPA runs as a separate process (apps/demo-backend-token/client).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@demo/backend-token-contract": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@orpc-ws/oidc-verifier-jose": "workspace:*",
    "@orpc-ws/server-nestjs": "workspace:*",
    "@orpc/server": "1.14.8",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
