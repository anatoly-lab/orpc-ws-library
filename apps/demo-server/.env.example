# Copy to .env and fill in your IdP details.
# .env is gitignored; this file is committed as documentation.
#
# Local-dev only. CI E2E does NOT read this file — testcontainers passes
# env vars directly via the spawned-process env.
#
# The demo server hosts THREE auth-mode demos, each run as its OWN process
# (the library's OrpcWsModule is single-instance per Nest app):
#   - pkce          (dev:pkce / start:pkce)          on PORT_PKCE
#   - backend-token (dev:backend-token / ...)        on PORT_BACKEND_TOKEN
#   - cookie-bff    (dev:cookie-bff / ...)           on PORT_COOKIE_BFF
# All three share the OIDC settings below.
#
# The demo server is OIDC-generic via Discovery — set OIDC_ISSUER_URL to any
# spec-compliant IdP (Keycloak realm, Auth0 tenant, Okta authorization
# server, ...) and both client and server figure out the rest from
# `.well-known/openid-configuration`.

# ---- OIDC (shared by all three modes) ----

# OIDC issuer URL — what the browser AND the server reach the IdP at.
# Keycloak: https://kc.example.com/realms/<realm-name>
# Auth0:    https://<tenant>.auth0.com/
# Okta:     https://<tenant>.okta.com/oauth2/default
OIDC_ISSUER_URL=https://idp.example.com/realms/my-realm

# OPTIONAL internal base URL the SERVER fetches discovery + JWKS from, for
# split-host (container) deployments. Omit in local dev.
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/my-realm

# OIDC client ID (public PKCE client registered with the IdP). Used by the
# pkce + backend-token WS-token verify (the token is minted for this client).
OIDC_CLIENT_ID=orpc-ws-demo-spa

# ---- Backend OIDC code-exchange (backend-token + cookie-bff) ----
#
# The backend modes run the OIDC Authorization-Code flow SERVER-SIDE using
# PKCE as a PUBLIC client — NO client secret. The code-exchange sends a PKCE
# `code_verifier`, not a `client_secret`. Defaults to OIDC_CLIENT_ID.
# OIDC_BACKEND_CLIENT_ID=orpc-ws-demo-spa
#
# CONFIDENTIAL-CLIENT SLOT (advanced, optional): only set this if you
# register a CONFIDENTIAL client for the server-side flow. Leaving it unset
# keeps the default public-PKCE path. Do NOT commit a real secret.
# OIDC_BACKEND_CLIENT_SECRET=

# ---- Ports (one per mode) ----
PORT_PKCE=18081
PORT_BACKEND_TOKEN=18082
PORT_COOKIE_BFF=18083
# Back-compat alias for PORT_PKCE (the original single-mode var):
# PORT=18081

# ---- SPA origins (per backend mode) ----
# Comma-separated list of origins for each mode's SPA. The FIRST entry is the
# post-/auth/callback redirect target; ALL entries are CORS-allowed (with
# credentials) for that mode's /auth/* fetches. Each SPA runs on TWO origins:
# the Vite dev server AND the `vite preview` build — list both so a preview
# build's credentialed fetches aren't blocked.
SPA_ORIGIN_BACKEND_TOKEN=http://localhost:5174,http://localhost:4174
SPA_ORIGIN_COOKIE_BFF=http://localhost:5175,http://localhost:4175

# PKCE-mode CORS origins (the upload HTTP-transport preflight; Bearer-authed,
# no cookie). Comma-separated. Defaults to the local-dev / e2e Vite ports.
DEMO_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Name of the httpOnly session cookie the backend modes set.
SESSION_COOKIE_NAME=sid

# ---- IdP registration reminder ----
# The two backend modes require their callback URIs registered as valid
# redirect URIs in the orpc-ws-demo realm (for the client above):
#   http://localhost:18082/auth/callback   (backend-token)
#   http://localhost:18083/auth/callback   (cookie-bff)
# And the post-logout redirect URIs (SPA origins above) as valid
# post-logout redirect URIs if you use RP-initiated logout.
