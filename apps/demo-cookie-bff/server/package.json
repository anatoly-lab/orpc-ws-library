{
  "name": "@demo/cookie-bff-server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS cookie-bff-mode demo server for the orpc-ws-library e2e suite. Full BFF: runs the OIDC flow, holds ALL tokens server-side, and the WS verify reads an httpOnly session cookie (no ?token=). The SPA runs as a separate process (apps/demo-cookie-bff/client).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@demo/cookie-bff-contract": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@orpc-ws/cookie-bff": "workspace:*",
    "@orpc-ws/cookie-bff-nestjs": "workspace:*",
    "@orpc-ws/server-nestjs": "workspace:*",
    "@orpc-ws/shared": "workspace:*",
    "@orpc/server": "1.14.6",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.0.1",
    "rimraf": "6.1.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
