# Demo SPA env. These VITE_* variables are INLINED into the bundle at
# `vite build` time (per Vite's env-handling rules), not read at runtime.
# Change here, then re-run `vite build` (or restart `vite dev`).
#
# Copy this file to `.env` (or `.env.local`) and tweak.

# WebSocket endpoint URL the ORPC client connects to. In the cookie-bff mode
# the demo server listens on 18083; auth rides as the httpOnly `sid` cookie the
# browser sends AUTOMATICALLY on the WS handshake — there is NO `?token=`.
VITE_WS_URL=ws://localhost:18083/ws

# Server origin for the auth HTTP endpoints (/auth/login, /auth/me,
# /auth/logout). The httpOnly `sid` cookie set by the server's /auth/callback
# authenticates GET /auth/me (credentials:"include").
VITE_SERVER_ORIGIN=http://localhost:18083
