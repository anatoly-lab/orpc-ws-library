{
  "name": "@demo/authless-server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS AUTHLESS demo server for the orpc-ws-library. Registers the library module with `mode: \"authless\"` — NO verifyClient, NO OIDC/Keycloak/session/cookie code. Every WS upgrade is accepted; procedures run with an empty ORPC context. The SPA runs as a separate process (apps/demo-authless/client).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@demo/authless-contract": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@orpc-ws/server-nestjs": "workspace:*",
    "@orpc/server": "1.14.6",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.0.0",
    "rimraf": "6.1.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
