# Copy to .env and tweak. .env is gitignored; this file is committed as
# documentation.
#
# This is the AUTHLESS demo server (port 18084). There is NO IdP, NO OIDC, NO
# session cookie, and NO token — so unlike the other demos there are no auth
# secrets to configure here. The only knobs are the listen port and the SPA
# origin allowlist for CORS.

# ---- Port ----
PORT=18084

# ---- SPA origins ----
# Comma-separated list of origins for this mode's SPA. ALL entries are
# CORS-allowed (no credentials) for the server's HTTP endpoints (just
# /health today). The SPA runs on TWO origins: the Vite dev server AND the
# `vite preview` build — list both.
SPA_ORIGIN_AUTHLESS=http://localhost:5176,http://localhost:4176
