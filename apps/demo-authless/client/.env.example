# Demo SPA env. This VITE_* variable is INLINED into the bundle at
# `vite build` time (per Vite's env-handling rules), not read at runtime.
# Change here, then re-run `vite build` (or restart `vite dev`).
#
# Copy this file to `.env` (or `.env.local`) and tweak.

# WebSocket endpoint URL the ORPC client connects to. In the authless mode
# the demo server listens on 18084. There is NO auth: no ?token=, no cookie,
# no Bearer header — every upgrade is accepted by the server.
VITE_WS_URL=ws://localhost:18084/ws
